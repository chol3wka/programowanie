<Window x:Class="generatorTestow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:generatorTestow"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1000">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Kategoria"></TextBlock>
            <TextBox x:Name="txtkategoria" Margin="0,0,0,10"></TextBox>

            <TextBlock Text="Pytanie"></TextBlock>
            <TextBox x:Name="txtpytanie" Height="70" TextWrapping="Wrap" Margin="0,0,0,10"></TextBox>

            <TextBlock Text="Odpowiedź A"></TextBlock>
            <TextBox x:Name="txtA" Margin="0,0,0,10"></TextBox>

            <TextBlock Text="Odpowiedź B"></TextBlock>
            <TextBox x:Name="txtB" Margin="0,0,0,10"></TextBox>

            <TextBlock Text="Odpowiedź C"></TextBlock>
            <TextBox x:Name="txtC" Margin="0,0,0,10"></TextBox>

            <TextBlock Text="Odpowiedź D"></TextBlock>
            <TextBox x:Name="txtD" Margin="0,0,0,10"></TextBox>

            <TextBlock Text="Poprawna Odpowiedź"></TextBlock>
            <ComboBox x:Name="cmbPoprawna" Margin="0,0,0,10" Background="White">
                <ComboBoxItem>A</ComboBoxItem>
                <ComboBoxItem>B</ComboBoxItem>
                <ComboBoxItem>C</ComboBoxItem>
                <ComboBoxItem>D</ComboBoxItem>
            </ComboBox>

            <Button Content="Dodaj pytanie" Height="35" Click="btnDodaj_pytanie" Background="Lavender"></Button>

            <Separator Margin="0,20"></Separator>

            <TextBlock Text="Generowanie testu" FontWeight="Bold"></TextBlock>
            <TextBox x:Name="txtTestKategoria" Margin="0,10,0,5" ToolTip="kategoria"></TextBox>
            <Button Content="Generuj test" Height="35" Click="btnGeneruj_test" Background="Lavender"></Button>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="104*"></RowDefinition>
                <RowDefinition Height="103*"/>
                <RowDefinition Height="250"></RowDefinition>
            </Grid.RowDefinitions>

            <GroupBox Header="Pytania" Grid.Row="0" Margin="10,10,10,10" Grid.RowSpan="2">
                <ListBox x:Name="lstPytania"></ListBox>
            </GroupBox>

            <GroupBox Header="Wygenerowany test" Grid.Row="2" Margin="10,10,10,10">
                <TextBox x:Name="txtWygenerowanyTest" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"></TextBox>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
