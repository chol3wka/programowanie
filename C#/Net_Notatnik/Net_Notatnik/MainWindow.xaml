<Window x:Class="Net_Notatnik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Net_Notatnik"
        mc:Ignorable="d"
        Title="Notatnik.net" Height="450" Width="800"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

	<DockPanel>
		<Menu IsMainMenu="True" DockPanel.Dock="Top">
			<MenuItem Header="_Plik">
				<MenuItem Header="_Nowy" InputGestureText="Ctrl+N" Click="MenuItem_Nowy_Click"/>
				<MenuItem Header="_Otwórz..." InputGestureText="Ctrl+O" Click="MenuItem_Otworz_Click"/>
				<MenuItem Header="Zapi_sz" InputGestureText="Ctrl+S" Click="MenuItem_Zapisz_Click"/>
				<MenuItem Header="_Zapisz jako.." Click="MenuItem_ZapiszJako_Click"/>
				<Separator/>
				<MenuItem Header="_Drukuj..."/>
				<MenuItem Header="Za_kończ" InputGestureText="Alt+F4" Click="MenuItem_Zamknij_Click"/>
			</MenuItem>

			<MenuItem Header="_Edycja">
				<MenuItem Header="_Cofnij" InputGestureText="Ctrl+Z" Click="MenuItem_Cofnij_Click"/>
				<MenuItem Header="_Powtórz" InputGestureText="Ctrl+Y" Click="MenuItem_Powtorz_Click"/>
				<MenuItem Header="_Kopiuj" InputGestureText="Ctrl+C" Click="MenuItem_Kopiuj_Click"/>
				<MenuItem Header="Wkl_ej" InputGestureText="Ctrl+V" Click="MenuItem_Wklej_Click"/>
				<MenuItem Header="_Usuń" InputGestureText="Del" Click="MenuItem_Usun_Click"/>
				<Separator/>
				<MenuItem Header="Zaznaz w_szystko" InputGestureText="Ctrl+A" Click="MenuItem_ZaznaczWszystko_Click"/>
				<MenuItem Header="_Godzina-Data" InputGestureText="F5" Click="MenuItem_GodzinaData_Click"/>
			</MenuItem>

			<MenuItem Header="_Widok">
				<MenuItem Header="_Zawijanie wierszy"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="MenuItem_Zawijanie_Click"/>

				<MenuItem Header="_Czcionka"
                          Click="MenuItem_Czcionka_Click"/>

				<MenuItem Header="_Kolor tła"
                          Click="MenuItem_KolorTla_Click"/>

				<Separator/>

				<MenuItem Header="Pasek _narzędzi"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="MenuItem_PasekNarzedzi_Click"/>

				<MenuItem Header="Pasek _stanu"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="MenuItem_PasekStanu_Click"/>
			</MenuItem>
		</Menu>

		<ToolBarTray x:Name="toolBarTray" DockPanel.Dock="Top"/>

		<StatusBar x:Name="statusBar" DockPanel.Dock="Bottom">
			<StatusBarItem>
				<TextBlock x:Name="statusBarText" Text="[Brak pliku]"/>
			</StatusBarItem>
		</StatusBar>

		<TextBox x:Name="TextBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 TextChanged="Textbox_TextChanged"/>
	</DockPanel>
</Window>
